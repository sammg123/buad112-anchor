<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key><string>en</string>
	<key>CFBundleDisplayName</key><string>Anchor</string>
	<key>CFBundleExecutable</key><string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key><string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
	<key>CFBundleName</key><string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key><string>APPL</string>
	<key>CFBundleShortVersionString</key><string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key><string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key><true/>
	<key>ITSAppUsesNonExemptEncryption</key><false/>
	<key>UILaunchScreen</key><dict/>
	<key>UIRequiredDeviceCapabilities</key><array><string>arm64</string></array>
	<key>UISupportedInterfaceOrientations</key><array><string>UIInterfaceOrientationPortrait</string></array>
	<key>UIBackgroundModes</key><array><string>location</string><string>audio</string></array>
	<key>NSSupportsLiveActivities</key><true/>
	<key>NSLocationWhenInUseUsageDescription</key><string>Anchor uses your location to know when you are inside a no-phone zone. Stop stays locked until you leave it.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key><string>Choose Always so Anchor can notice when you walk into a no-phone zone, and keep checking while you use other apps.</string>
	<key>NSLocationTemporaryUsageDescriptionDictionary</key>
	<dict><key>zones</key><string>Anchor needs your precise location to tell whether you're inside a no-phone zone.</string></dict>
	<key>NSMotionUsageDescription</key><string>Anchor checks whether your phone is sitting still, so GPS drift indoors can never unlock Stop while you study.</string>
	<key>LSApplicationQueriesSchemes</key><array><string>shortcuts</string></array>
	<key>CFBundleURLTypes</key>
	<array><dict>
		<key>CFBundleURLName</key><string>com.sammg123.anchor</string>
		<key>CFBundleURLSchemes</key><array><string>anchorstudy</string></array>
	</dict></array>
</dict>
</plist>
